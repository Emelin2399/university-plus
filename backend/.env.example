# ============================================================
# UNIVERSITY PLUS — Backend environment variables
# Copia este archivo a `.env` y completa los valores.
# ⚠️ NUNCA subas el .env real al repositorio.
# ============================================================

# --- App ---
APP_ENV=development
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
# Clave anónima (pública) — usada para validar JWT de usuarios
SUPABASE_ANON_KEY=your-anon-key
# Clave de servicio (SECRETA) — solo en el backend, nunca en el frontend
SUPABASE_SERVICE_KEY=your-service-role-key
# Bucket de Storage para documentos
SUPABASE_STORAGE_BUCKET=documents

# --- Proveedor de IA ---
# Deja AI_PROVIDER=mock para desarrollar sin consumir API real
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- EXPLORA PLUS (fuentes académicas) ---
# Vacío = automático (mock si AI_PROVIDER=mock; openalex en caso contrario).
# Opciones: mock | openalex | crossref
EXPLORA_PROVIDER=

# --- Límites (control de costos y seguridad) ---
MAX_UPLOAD_MB=20
MAX_DOCUMENTS_PER_USER=50
